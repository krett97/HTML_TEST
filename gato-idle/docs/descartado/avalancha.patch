   return !!obj && (!next || next.casa !== obj.casa);
 }
 
+/** Primer y último nivel (índices) del cuarto al que pertenece un objeto. */
+export function roomRange(data: GameData, index: number): { inicio: number; fin: number } {
+  const last = data.objects.length - 1;
+  const at = Math.min(Math.max(0, index), last);
+  let inicio = at;
+  while (inicio > 0 && !isLastOfRoom(data, inicio - 1)) inicio--;
+  let fin = at;
+  while (fin < last && !isLastOfRoom(data, fin)) fin++;
+  return { inicio, fin };
+}
+
 /** Qué detiene el avance al terminar el nivel: el guardián del cuarto, el jefe de la casa o la mudanza. */
 export type Gate = 'miniJefe' | 'jefe' | 'mudanza';
 
