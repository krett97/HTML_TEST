<?xml version="1.0" encoding="utf-8"?>
<!-- APK de prueba: un visor que carga el juego en un solo HTML. No es la app final (esa es android/, con Capacitor). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.krett97.gatoidle.prueba">

    <!-- targetSdk 34: el 35 obliga a dibujar bajo las barras del sistema y este visor no lo maneja. -->
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

    <application
        android:label="Swat (prueba)"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
